# انسخ هذا الملف إلى .env واملأ القيم — التفاصيل في REQUIREMENTS.md

# ── قاعدة البيانات — PostgreSQL ──
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# ── الأسرار (ولّدها: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
AUTH_SECRET=""
CRON_SECRET=""
CHAT_SECRET=""
# مفاتيح CHAT_SECRET القديمة، مفصولة بفواصل، للقراءة أثناء التدوير فقط
CHAT_SECRET_PREVIOUS=""

# ── الدومين ──
NEXT_PUBLIC_SITE_URL="https://harajstation.com"

# ── بوابة الإدارة — لما تُضبط، الأدمن يشتغل فقط على هذا الدومين ويختفي من الموقع
#    (اتركها فارغة في التطوير ليبقى /admin متاحاً على localhost) ──
ADMIN_HOST=""

# ── Cloudflare R2 (تخزين الصور — اتركها فارغة للحفظ المحلي في التطوير) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ── Moyasar (الدفع معطّل افتراضيًا حتى اكتمال حساب البوابة والـwebhook) ──
PAYMENTS_ENABLED="false"
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# ── SMTP — Brevo (البريد — اتركها فارغة ليظهر رابط الاستعادة على الشاشة في التطوير) ──
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="حراج ستيشن <noreply@harajstation.com>"
MAIL_REPLY_TO="support@harajstation.com"

# ── Web Push (ولّدها: npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Google OAuth (اختياري — زر Google يعمل بوضع تجريبي بدونها) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Redis (إلزامي في الإنتاج مع أكثر من عامل PM2) ──
REDIS_URL="redis://127.0.0.1:6379"

# ── ميزات اختيارية ──
ANTHROPIC_API_KEY=""
NEXT_PUBLIC_GA_ID=""
SENTRY_DSN=""

# ── النسخ الاحتياطي ──
# مستلم age عام فقط؛ المفتاح الخاص لا يوضع في المشروع أو .env
BACKUP_AGE_RECIPIENT=""
# وجهة rclone اختيارية، مثال: remote:harajstation
BACKUP_REMOTE=""

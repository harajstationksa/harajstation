# انسخ هذا الملف إلى .env واملأ القيم — التفاصيل في REQUIREMENTS.md

# ── قاعدة البيانات — PostgreSQL ──
# The app is a long-lived process (PM2), not serverless: use the SESSION pooler
# (port 5432). Measured 2026-10-09 from the server: ~26ms per query vs ~121ms
# through the transaction pooler (6543). Keep the pool small — 2 workers share
# Supabase's connection limit.
DATABASE_URL="postgresql://user:pass@host:5432/postgres?connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# ── الأسرار (ولّدها: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
AUTH_SECRET=""
ADMIN_AUTH_SECRET=""
CRON_SECRET=""
CHAT_SECRET=""
# مفاتيح CHAT_SECRET القديمة، مفصولة بفواصل، للقراءة أثناء التدوير فقط
CHAT_SECRET_PREVIOUS=""

# ── الدومين ──
NEXT_PUBLIC_SITE_URL="https://harajstation.com"

# ── بوابة الإدارة — لما تُضبط، الأدمن يشتغل فقط على هذا الدومين ويختفي من الموقع
#    (اتركها فارغة في التطوير ليبقى /admin متاحاً على localhost) ──
ADMIN_HOST=""

# ── Cloudflare R2 (تخزين الصور — اتركها فارغة للحفظ المحلي في التطوير) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ── Moyasar (الدفع معطّل افتراضيًا حتى اكتمال حساب البوابة والـwebhook) ──
PAYMENTS_ENABLED="false"
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# ── SMTP — Brevo (البريد مطلوب لتسليم رسائل التحقق والدعوات) ──
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="حراج ستيشن <noreply@harajstation.com>"
MAIL_REPLY_TO="support@harajstation.com"

# ── Web Push (ولّدها: npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Google OAuth (اختياري؛ الاختصار التجريبي يحتاج تفعيلًا صريحًا) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOW_DEV_SOCIAL="false"

# ── Redis (إلزامي في الإنتاج مع أكثر من عامل PM2) ──
REDIS_URL="redis://127.0.0.1:6379"

# ── ميزات اختيارية ──
ANTHROPIC_API_KEY=""
NEXT_PUBLIC_GA_ID=""
# تفعيل صريح للتتبع؛ اتركه false ما لم تكن الموافقة والسياسة مهيأتين
NEXT_PUBLIC_GA_ENABLED="false"
SENTRY_DSN=""

# ── النسخ الاحتياطي ──
# مستلم age عام فقط؛ المفتاح الخاص لا يوضع في المشروع أو .env
BACKUP_AGE_RECIPIENT=""
# وجهة rclone اختيارية، مثال: remote:harajstation
BACKUP_REMOTE=""

# Temporary read-only legacy chat key; remove after migration reports zero legacy rows.
CHAT_LEGACY_AUTH_SECRET=""
# Enable only after HTTPS is verified for every subdomain.
HSTS_PRELOAD="false"

# Separate bucket with public access DISABLED; never reuse R2_BUCKET.
R2_PRIVATE_BUCKET=""

# Independent, PRIVATE destination for encrypted offsite backups (never R2_BUCKET,
# never with public/r2.dev access). Use a token scoped to this bucket only;
# BACKUP_R2_ACCOUNT_ID may point at a separate Cloudflare account.
BACKUP_R2_BUCKET=""
BACKUP_R2_ACCOUNT_ID=""
BACKUP_R2_ACCESS_KEY_ID=""
BACKUP_R2_SECRET_ACCESS_KEY=""

# One Server Actions key for every build (base64, 32 bytes). deploy/deploy.sh
# generates it once in production if missing.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
